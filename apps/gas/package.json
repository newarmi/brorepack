{
  "name": "@brorepack/gas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "node build.mjs && node --import tsx --test test/*.test.ts",
    "push": "node build.mjs && clasp push --force",
    "deploy": "clasp deploy",
    "logs": "clasp logs",
    "local": "node build.mjs && tsx scripts/local-server.ts"
  },
  "dependencies": {
    "@brorepack/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
