{
  "name": "@brorepack/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prisma.mjs db push --skip-generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/prisma.mjs generate && tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "db:push": "node scripts/prisma.mjs db push",
    "db:generate": "node scripts/prisma.mjs generate",
    "fonts": "node scripts/fetch-fonts.mjs",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "platform": "node",
    "target": "node22",
    "outDir": "dist",
    "clean": true,
    "sourcemap": true,
    "noExternal": [
      "@brorepack/shared"
    ],
    "external": [
      "@prisma/client",
      "@resvg/resvg-js"
    ]
  },
  "dependencies": {
    "@brorepack/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
