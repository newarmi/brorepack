# Скопируй в apps/server/.env и заполни. Без .env сервер стартует в полностью мок-режиме.

# Порт и адрес HTTP-сервера
PORT=3000
# HOST=0.0.0.0

# development | production. В production: JSON-логи, без CORS
NODE_ENV=development

# SQLite. Относительный путь считается от apps/server/prisma → prisma/dev.db
DATABASE_URL=file:./dev.db

# --- Telegram-бот ---
# Токен от @BotFather. Без него бот выключен, вход возможен только через DEV_AUTH_BYPASS
BOT_TOKEN=
# polling | webhook | off. По умолчанию: polling, если задан BOT_TOKEN, иначе off
BOT_MODE=
# Публичный https-адрес вебхука (для BOT_MODE=webhook). Сервер слушает POST /bot/webhook.
# Если не задан — берётся <origin WEBAPP_URL>/bot/webhook
BOT_WEBHOOK_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (A-Z, a-z, 0-9, _ и -).
# Если не задан — выводится из BOT_TOKEN
BOT_WEBHOOK_SECRET=
# https-адрес Mini App (фронтенд). Кнопки web_app в Telegram работают только с https
WEBAPP_URL=
# Telegram id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=

# --- Оплата ---
# mock — без оплаты, есть POST /api/orders/:id/mock-pay; telegram — Telegram Payments (ЮKassa)
PAYMENTS_MODE=mock
# Токен провайдера из @BotFather → /mybots → Payments → ЮKassa (сначала тестовый)
PAYMENT_PROVIDER_TOKEN=

# --- FACEIT ---
# mock — фейковые профили (goodlifeee — как в макете, notfound — «не найден»); live — FACEIT Data API
FACEIT_MODE=mock
# Server-side API key из https://developers.faceit.com → App Studio
FACEIT_API_KEY=

# --- Разработка ---
# 1 — принимать `Authorization: tma dev:<telegramId>` (для запуска в обычном браузере). В проде — никогда!
DEV_AUTH_BYPASS=1

# Папка со сборкой фронтенда, относительно apps/server. Если в ней есть index.html — сервер её раздаёт
WEB_DIST_DIR=../web/dist
