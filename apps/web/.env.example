# Бэкенд: rest — Node-сервер из apps/server (локально через прокси /api),
#         gas  — Google Apps Script из apps/gas
VITE_API_TRANSPORT=rest

# Адрес развёртывания Apps Script, вида https://script.google.com/macros/s/<id>/exec
VITE_GAS_URL=

# Ссылка на бота для кнопки «Поделиться превью»
VITE_BOT_URL=

# Telegram id «пользователя» вне Telegram (сервер принимает только с DEV_AUTH_BYPASS=1)
VITE_DEV_USER_ID=1
